# All of these are OPTIONAL. Krushi works out of the box with zero keys:
#   - weather comes from Open-Meteo (free, keyless)
#   - the crop model trains on the bundled real dataset
#   - market prices for potato/tomato/wheat (ML-predicted) and onion/gram/
#     cucumber/brinjal/cluster beans/bottle gourd/amaranthus/carrot/snake
#     gourd/lemon (real observed median, from live Agmarknet records) all
#     work with zero keys — no simulation, ever
#
# Add keys below only if you want more crops covered live, or another
# weather provider.

# Alternative weather provider (openweathermap.org). Leave blank to use
# Open-Meteo (the default, free, no key needed).
OPENWEATHER_API_KEY=

# Free key from https://data.gov.in/ — enables real Indian mandi market
# prices instead of the simulated fallback.
MARKET_API_KEY=

# Enables the "Ask Krushi" chatbot (real Google Gemini API call). Get a
# free key at https://aistudio.google.com/apikey (no credit card needed).
# The free tier has generous per-minute/per-day limits, not a literal
# unlimited quota — if you hit them the chat page will say so plainly.
# Leave blank and the chat page will tell the user honestly that it isn't
# configured, instead of faking a reply.
GEMINI_API_KEY=
CHAT_MODEL=gemini-2.5-flash

# Enables real password-reset/welcome emails. Without either of the two
# options below configured, "forgot password" still works but returns
# the reset token directly in the response instead of emailing it
# (clearly labeled as a dev-mode fallback).
#
# OPTION A — Brevo API (recommended for hosting, e.g. Render's free
# tier): most cloud hosts block outbound SMTP ports (25/465/587) on
# free/low-cost plans as an anti-spam measure — this bypasses that
# entirely since it runs over plain HTTPS. Free tier covers 300
# emails/day. Sign up at https://www.brevo.com, verify your sender
# email under Settings, then generate a plain API key (NOT the "MCP
# server" option, and NOT the separate SMTP key — those are different
# credentials) under Settings > SMTP & API > API Keys.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Krushi

# OPTION B — plain SMTP. Fine for local development or any host that
# doesn't block outbound SMTP; if BREVO_API_KEY above is set, that takes
# priority and this is ignored.
#
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your
# Gmail address, SMTP_PASSWORD=a 16-character App Password (NOT your
# normal Gmail password — generate one at https://myaccount.google.com/apppasswords,
# requires 2-Step Verification to be turned on first). SMTP_FROM can be
# left blank to default to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SECRET_KEY=change-this-to-a-random-string
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, the app still boots (using a random per-process key) but
# warns loudly — sessions won't survive a restart and this is unsafe for
# any multi-worker or production deployment.

# Where the SQLite database file lives. Leave blank for local dev (it
# defaults to krushi.db next to app.py). In production on a host that
# wipes its filesystem on every redeploy (Render, Railway, etc.), point
# this at your platform's persistent volume mount path instead — e.g.
# /data/krushi.db — or every registered user disappears on the next push.
DATABASE_PATH=

# Comma-separated list of origins allowed to make credentialed requests to
# this API. Defaults to localhost if left blank. Set this to your real
# deployed domain(s) in production — do NOT leave it wide open.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Set to 1 once this app is served over HTTPS, so session cookies are
# marked Secure (never sent over plain http). Leave 0 for local dev.
COOKIE_SECURE=0

# Set to 1 to enable Flask's debug mode (auto-reload, interactive
# in-browser debugger). NEVER enable this on anything reachable outside
# your own machine — the debugger allows arbitrary code execution.
FLASK_DEBUG=0

# Optional: point rate limiting (login/register/chat) at a shared Redis
# store instead of in-process memory. Only needed if you're running more
# than one worker process/instance behind a load balancer — otherwise
# each worker would enforce its own separate limit.
REDIS_URL=

# ---------------------------------------------------------------------------
# KrushiMitra AI additions
# ---------------------------------------------------------------------------
# Embedding model for the RAG knowledge base (falls back automatically if retired).
EMBED_MODEL=gemini-embedding-001
# Retrieval relevance thresholds (defaults are calibrated on the built-in knowledge base).
RAG_MIN_KEYWORD=0.11
RAG_MIN_DENSE=0.45
# Where leaf photos are stored. They are NEVER served from /static; leave blank for ./private_uploads
UPLOAD_DIR=
# DEV ONLY: lets "forgot password" return the code in the HTTP response when email isn't configured.
# Leave 0 (or unset) for any real deployment - otherwise anyone could reset any account.
ALLOW_DEV_RESET_CODES=0
# Set to 1 once served over HTTPS so session cookies are marked Secure.
COOKIE_SECURE=0
